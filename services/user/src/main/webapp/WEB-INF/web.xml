<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0" metadata-complete="true">
    <display-name>Scooter User Service</display-name>
    <listener>
        <listener-class>ru.scooter.user.config.AppContextListener</listener-class>
    </listener>
    <filter>
        <filter-name>errors</filter-name>
        <filter-class>ru.scooter.user.filter.ErrorFilter</filter-class>
    </filter>
    <filter>
        <filter-name>cors</filter-name>
        <filter-class>ru.scooter.user.filter.CorsFilter</filter-class>
    </filter>
    <filter>
        <filter-name>auth</filter-name>
        <filter-class>ru.scooter.user.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>errors</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>cors</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>auth</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>
    <servlet>
        <servlet-name>register</servlet-name>
        <servlet-class>ru.scooter.user.servlet.RegisterServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>login</servlet-name>
        <servlet-class>ru.scooter.user.servlet.LoginServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>logout</servlet-name>
        <servlet-class>ru.scooter.user.servlet.LogoutServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>users</servlet-name>
        <servlet-class>ru.scooter.user.servlet.UsersServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>not-found</servlet-name>
        <servlet-class>ru.scooter.user.servlet.NotFoundServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>register</servlet-name>
        <url-pattern>/api/users/register</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>login</servlet-name>
        <url-pattern>/api/users/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>logout</servlet-name>
        <url-pattern>/api/users/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>users</servlet-name>
        <url-pattern>/api/users/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>not-found</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>
</web-app>
