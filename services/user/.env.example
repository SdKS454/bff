# This is a reference file: Java reads process environment, not this file automatically.
DB_URL=jdbc:postgresql://localhost:5432/scooter_users
DB_USER=scooter_user
DB_PASSWORD=choose-a-local-password
JWT_PRIVATE_KEY_PATH=/absolute/path/to/secrets/private.pem
JWT_PUBLIC_KEY_PATH=/absolute/path/to/secrets/public.pem
JWT_ISSUER=scooter-user-service
JWT_TTL_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:8082
MODERATION_BASE_URL=http://localhost:8082
MODERATION_TIMEOUT_SECONDS=3
BCRYPT_COST=12
# Integration tests only; MUST point at a separate disposable database.
# TEST_DB_URL=jdbc:postgresql://localhost:5432/scooter_users_test
# TEST_DB_USER=scooter_user
# TEST_DB_PASSWORD=choose-a-local-password
